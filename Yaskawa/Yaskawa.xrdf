format: "xrdf"

format_version: 2.0

default_joint_positions:
  joint_1_s: 0.0
  joint_2_l: 0.0
  joint_3_u: 0.0
  joint_4_r: 0.0
  joint_5_b: 0.0
  joint_6_t: 0.0

cspace:
  joint_names:
    - joint_1_s
    - joint_2_l
    - joint_3_u
    - joint_4_r
    - joint_5_b
    - joint_6_t

  acceleration_limits:
    - 10.0
    - 10.0
    - 10.0
    - 10.0
    - 10.0
    - 10.0

  jerk_limits:
    - 100.0
    - 100.0
    - 100.0
    - 100.0
    - 100.0
    - 100.0

world_collision:
  geometry: "auto_generated_collision_sphere_group"

self_collision:
  geometry: "auto_generated_collision_sphere_group"
  ignore:
    base_link:
      - link_1_s
    link_1_s:
      - link_2_l
    link_2_l:
      - link_3_u
    link_3_u:
      - link_4_r
    link_4_r:
      - link_5_b
    link_5_b:
      - link_6_t

geometry:
  auto_generated_collision_sphere_group:
    spheres:
      base_link:
        - center: [0.039, -0.042, 0.135]
          radius: 0.1705

      link_1_s:
        - center: [0.078, 0.003, -0.03]
          radius: 0.1636

      link_2_l:
        - center: [0.396, -0.05, 0.123]
          radius: 0.1178

      link_3_u:
        - center: [-0.012, 0.013, 0.019]
          radius: 0.1583

      link_4_r:
        - center: [-0.001, -0.009, 0.605]
          radius: 0.1257

      link_5_b:
        - center: [0.013, -0.007, 0.012]
          radius: 0.0966

      link_6_t:
        - center: [0.016, 0.016, 0.012]
          radius: 0.0475